{
	"name": "pawsops",
	"version": "0.1.0",
	"private": true,
	"description": "Demo of Slack's Add to Slack (managed apps): one manager app that provisions a dedicated Slack app per agent.",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"manifests": "tsx scripts/export-manifests.ts",
		"icons": "tsx scripts/make-icons.ts",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@slack/bolt": "^4.4.0",
		"@slack/web-api": "^8.3.0",
		"dotenv": "^16.4.7",
		"express": "^5.1.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}
