# Public HTTPS URL that tunnels to this server (ngrok, cloudflared, etc.)
# Used in child app manifests for event and interactivity request URLs.
PUBLIC_URL=https://your-tunnel.example.com
PORT=3000

# MOCK_MODE=true simulates the flagged managed-app calls (apps.managedInstall,
# apps.managed.permissions.set) and wires up 3 child apps you created by hand.
# MOCK_MODE=false makes every call for real (requires the Partnerships feature flag).
MOCK_MODE=true

# ---- Manager app (PawsOps) ----
# From the manager app's Basic Information page.
MANAGER_CLIENT_ID=
MANAGER_CLIENT_SECRET=
MANAGER_SIGNING_SECRET=
# Random string used to sign the OAuth state parameter.
STATE_SECRET=change-me

# ---- Pre-made child apps (MOCK_MODE=true only) ----
# Create each from manifests/*.json, install to your sandbox, then paste values here.
CLIENT_UPDATES_APP_ID=
CLIENT_UPDATES_BOT_TOKEN=
CLIENT_UPDATES_SIGNING_SECRET=

OVERTIME_APPROVER_APP_ID=
OVERTIME_APPROVER_BOT_TOKEN=
OVERTIME_APPROVER_SIGNING_SECRET=

INVENTORY_TRACKER_APP_ID=
INVENTORY_TRACKER_BOT_TOKEN=
INVENTORY_TRACKER_SIGNING_SECRET=

# ---- Demo channels ----
MANAGERS_CHANNEL=managers
OUTBOX_CHANNEL=outbox
