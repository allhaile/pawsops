PORT=3000

# MOCK_MODE=true simulates the managed-app calls (apps.manifest.create, apps.icon.set,
# apps.managed.permissions.set, apps.managedInstall, apps.manifest.update/delete) and
# connects 3 child apps you created by hand from manifests/.
# MOCK_MODE=false makes every call for real (requires the Partnerships feature flag).
MOCK_MODE=true

# socket (no tunnel needed) or http (needs PUBLIC_URL to be a public HTTPS tunnel)
TRANSPORT=socket
PUBLIC_URL=http://localhost:3000

# ---- PawsOps manager app ----
# Install & OAuth page: Bot User OAuth Token (xoxb-) and User OAuth Token (xoxp-)
MANAGER_BOT_TOKEN=
MANAGER_USER_TOKEN=
# Basic Information → App-Level Tokens, scope connections:write (xapp-). Socket Mode only.
MANAGER_APP_TOKEN=
# Basic Information → Signing Secret. HTTP transport only.
MANAGER_SIGNING_SECRET=

# Optional, mock mode only: an app configuration token from api.slack.com/apps (expires after 12 hours).
# When set, rename and icon upload run for real against the pre-made apps.
SLACK_CONFIG_TOKEN=

# ---- Pre-made child apps (MOCK_MODE=true only) ----
# Create each from manifests/<agent>.json, install it, then copy:
#   APP_ID         Basic Information → App ID
#   BOT_TOKEN      Install App → Bot User OAuth Token (xoxb-)
#   APP_TOKEN      Basic Information → App-Level Tokens, scope connections:write (xapp-)
#   SIGNING_SECRET Basic Information → Signing Secret (HTTP transport only)
CLIENT_UPDATES_APP_ID=
CLIENT_UPDATES_BOT_TOKEN=
CLIENT_UPDATES_APP_TOKEN=
CLIENT_UPDATES_SIGNING_SECRET=

OVERTIME_APPROVER_APP_ID=
OVERTIME_APPROVER_BOT_TOKEN=
OVERTIME_APPROVER_APP_TOKEN=
OVERTIME_APPROVER_SIGNING_SECRET=

INVENTORY_TRACKER_APP_ID=
INVENTORY_TRACKER_BOT_TOKEN=
INVENTORY_TRACKER_APP_TOKEN=
INVENTORY_TRACKER_SIGNING_SECRET=

# ---- Demo channels ----
MANAGERS_CHANNEL=managers
OUTBOX_CHANNEL=outbox
