{
	"display_information": {
		"name": "Overtime Approver",
		"description": "Flags employees past 40 hours and asks a manager to approve or deny overtime.",
		"long_description": "I check ADP hours and post an approval card in #managers when someone passes 40 hours. Built and deployed with PawsOps for Paws & Stay.",
		"background_color": "#C0392B"
	},
	"features": {
		"app_home": {
			"home_tab_enabled": false,
			"messages_tab_enabled": true,
			"messages_tab_read_only_enabled": false
		},
		"bot_user": {
			"display_name": "Overtime Approver",
			"always_online": true
		},
		"slash_commands": [
			{
				"command": "/overtime-check",
				"description": "Check ADP hours for overtime",
				"should_escape": false
			}
		]
	},
	"oauth_config": {
		"scopes": {
			"bot": [
				"app_mentions:read",
				"chat:write",
				"commands",
				"users:read"
			]
		}
	},
	"settings": {
		"event_subscriptions": {
			"bot_events": [
				"app_mention"
			]
		},
		"interactivity": {
			"is_enabled": true
		},
		"socket_mode_enabled": true,
		"org_deploy_enabled": false,
		"token_rotation_enabled": false
	}
}
